# Copy to .env and replace every placeholder before starting services.
APP_ENV=development
APP_NAME=AI Video Studio
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

POSTGRES_DB=video_studio
POSTGRES_USER=video_studio
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_SECRET
DATABASE_URL=postgresql+psycopg://video_studio:CHANGE_ME_LONG_RANDOM_SECRET@postgres:5432/video_studio

VALKEY_PASSWORD=CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET
CELERY_BROKER_URL=redis://:CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET@valkey:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET@valkey:6379/1

OLLAMA_BASE_URL=http://host.docker.internal:11434
COMFYUI_BASE_URL=http://comfyui:8188
MEDIA_ROOT=/srv/video-studio/data
MAX_UPLOAD_GB=20
MAX_PROJECT_GPU_SECONDS=7200
MAX_GENERATION_RETRIES_PER_SHOT=2
REQUIRE_APPROVAL_BEFORE_GENERATION=true
REQUIRE_APPROVAL_BEFORE_EXPORT=true
