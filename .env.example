# Copy to .env and generate four different URL-safe secrets. Never commit .env.
APP_ENV=development
APP_NAME=AI Video Studio
LOG_LEVEL=INFO

POSTGRES_DB=video_studio
POSTGRES_BOOTSTRAP_USER=video_studio_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=REPLACE_WITH_BOOTSTRAP_SECRET
DATABASE_MIGRATOR_USER=video_studio_migrator
DATABASE_MIGRATOR_PASSWORD=REPLACE_WITH_MIGRATOR_SECRET
DATABASE_RUNTIME_USER=video_studio_runtime
DATABASE_RUNTIME_PASSWORD=REPLACE_WITH_RUNTIME_SECRET
VALKEY_PASSWORD=REPLACE_WITH_VALKEY_SECRET

# Bind this to a private host directory. Prefer a path outside the repository.
# Windows example: C:/Users/MSI/AI-Video-Studio-Data
MEDIA_HOST_PATH=./data

# Docker Compose supplies DATABASE_URL and CELERY_BROKER_URL to containers.
# For direct local development, omit DATABASE_URL to use SQLite under MEDIA_ROOT.
# DATABASE_URL=postgresql+psycopg://video_studio_runtime:...@localhost:5432/video_studio
# CELERY_BROKER_URL=redis://:...@localhost:6379/0

MEDIA_ROOT=/srv/video-studio/data
MAX_UPLOAD_GB=20
MAX_PROJECT_GPU_SECONDS=7200
MAX_GENERATION_RETRIES_PER_SHOT=2
REQUIRE_APPROVAL_BEFORE_GENERATION=true
REQUIRE_APPROVAL_BEFORE_EXPORT=true
