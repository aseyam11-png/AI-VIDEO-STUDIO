# Copy to .env and generate four different URL-safe secrets. Never commit .env.
APP_ENV=development
APP_NAME=AI Video Studio
LOG_LEVEL=INFO

POSTGRES_DB=video_studio
POSTGRES_BOOTSTRAP_USER=video_studio_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=REPLACE_WITH_BOOTSTRAP_SECRET
DATABASE_MIGRATOR_USER=video_studio_migrator
DATABASE_MIGRATOR_PASSWORD=REPLACE_WITH_MIGRATOR_SECRET
DATABASE_RUNTIME_USER=video_studio_runtime
DATABASE_RUNTIME_PASSWORD=REPLACE_WITH_RUNTIME_SECRET
VALKEY_PASSWORD=REPLACE_WITH_VALKEY_SECRET

# Bind this to a private host directory. Prefer a path outside the repository.
# Windows example: C:/Users/MSI/AI-Video-Studio-Data
MEDIA_HOST_PATH=./data

# Docker Compose supplies DATABASE_URL and CELERY_BROKER_URL to containers.
# For direct local development, omit DATABASE_URL to use SQLite under MEDIA_ROOT.
# DATABASE_URL=postgresql+psycopg://video_studio_runtime:...@localhost:5432/video_studio
# CELERY_BROKER_URL=redis://:...@localhost:6379/0

MEDIA_ROOT=/srv/video-studio/data
MAX_UPLOAD_GB=20
MAX_PROJECT_GPU_SECONDS=7200
MAX_GENERATION_RETRIES_PER_SHOT=2
REQUIRE_APPROVAL_BEFORE_GENERATION=true
REQUIRE_APPROVAL_BEFORE_EXPORT=true

# Optional model runtime. Start with: docker compose --profile ollama up -d ollama
# Compose Ollama URL: http://ollama:11434. Windows-host Ollama URL: http://host.docker.internal:11434.
# Pin OLLAMA_IMAGE to a tested tag/digest before production use.
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_TIMEOUT_SECONDS=180

COMFYUI_BASE_URL=
COMFYUI_API_KEY=
COMFYUI_REQUEST_TIMEOUT_SECONDS=120
COMFYUI_JOB_TIMEOUT_SECONDS=7000
MODEL_WORKFLOW_REGISTRY=/srv/video-studio/data/workflows/registry.json

# Install/configure these separately; no DeepFilterNet weights are downloaded by Studio.
DEEPFILTER_SCRIPT=
DEEPFILTER_MODEL_DIR=
DEEPFILTER_PYTHON=python

# Optional Blender binary path, visible inside worker-models.
BLENDER_EXECUTABLE=
INSTALL_BLENDER=0

# Enable the optional speech queue only when WhisperX is required.
# The separate worker-speech image installs the speech extra; no weights ship in the image.
CPU_WORKER_EXTRAS=media
SPEECH_WORKER_ENABLED=false
